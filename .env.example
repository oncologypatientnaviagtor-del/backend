PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/patient-navigator
CLIENT_ORIGIN=http://localhost:5173

# Server-side only. Never put these in the frontend.
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai

# Used by the langchain branch. Leave blank on the Lyzr line.
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=navigator-knowledge

# From Neo4j Desktop or Aura. Leave the password empty until the database is started.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
